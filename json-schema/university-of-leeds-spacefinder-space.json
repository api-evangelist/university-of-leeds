    "atmosphere": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cosy",
          "disciplined",
          "friendly",
          "historic",
          "inspiring",
          "inspiring'",
          "modern",
          "relaxed",
          "social"
